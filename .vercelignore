# Don't upload these to Vercel — they aren't needed to build the app, and the
# Playwright Chrome download (chrome/, ~275 MB) blows past the 100 MB file cap.
chrome/
node_modules/
.git/
dist/
playwright-report/
test-results/
tests/
scripts/
*.log

# Nested language-crew worktrees — ~19 full repo copies (node_modules +
# public/audio each). Without this a local `vercel --prod` uploads gigabytes of
# them. See .gitignore for why they end up inside the root.
/lingua-*/
/drill-tools/
